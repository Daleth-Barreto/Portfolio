---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmt = (d) =>
  new Intl.DateTimeFormat('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
---
<Base title="Blog · Daleth" description="Writings by Alan Daleth Hernández Barreto on robotics, quantum computing, competitive programming and more.">
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Blog</span>
        <h1>A ghost’s <span style="text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 6px;">logbook</span></h1>
        <p style="color: var(--muted); font-size: 1.1rem;">
          Notes, competition stories and research notes. Unfiltered.
        </p>
      </div>

      <div class="post-grid reveal">
        {
          posts.map((post) => (
            <a class="post-card" href={`/blog/${post.slug}/`}>
              <span class="date">{fmt(post.data.pubDate)}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div>
                {post.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  import '../../lib/experience.js';
</script>
