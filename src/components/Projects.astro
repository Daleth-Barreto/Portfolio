---
import { projects } from '../data/profile.js';
---
<section class="section" id="proyectos">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Projects</span>
      <h2>Things I’ve<br />shipped</h2>
      <p style="color: var(--muted); font-size: 1.1rem; margin-top: 1.4rem;">
        A selection from 36 GitHub repositories.
      </p>
    </div>
    <div class="grid grid-2 reveal">
      {projects.map((p, i) => (
        <a class="card" href={p.url} target="_blank" rel="noopener noreferrer">
          <span class="meta">#{String(i + 1).padStart(2, '0')} · repo · GitHub</span>
          <h4>{p.name}</h4>
          <p>{p.desc}</p>
          <div>
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
