---
import { profile } from '../data/profile.js';

const links = [
  { href: '/#inicio', label: 'Home' },
  { href: '/#trayectoria', label: 'Journey' },
  { href: '/#logros', label: 'Awards' },
  { href: '/#publicaciones', label: 'Research' },
  { href: '/#proyectos', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/#contacto', label: 'Contact' },
];
---
<nav class="menu" aria-label="Principal">
  <a class="menu-logo" href="/">
    <span class="ghost-mark" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 64 64" fill="none">
        <path
          d="M32 6c-12.7 0-22 9.6-22 22v26c0 2 2.3 3 4 2l4.5-3 5 3.4c1.4.9 3.1.9 4.5 0L32 54l4.5 2.4c1.4.9 3.1.9 4.5 0l5-3.4 4.5 3c1.7 1 4 0 4-2V28c0-12.4-9.3-22-22-22Z"
          fill="#FFF6EA"
          stroke="#2B2B45"
          stroke-width="3"
          stroke-linejoin="round"
        />
        <path d="M23 30a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm18 0a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" fill="#2B2B45" />
        <path d="M32 38c-1.8 0-3.2 1.4-3.2 3.2v.4c0 1.8 1.4 3.2 3.2 3.2s3.2-1.4 3.2-3.2v-.4c0-1.8-1.4-3.2-3.2-3.2Z" fill="#2B2B45" />
      </svg>
    </span>
    <span>daleth-hb.dev</span>
  </a>

  <div class="menu-nav">
    {links.map((l) => <a class="menu-link" href={l.href}>{l.label}</a>)}
    <button class="menu-burger" id="menuBurger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menuPanel">
      <span></span><span></span><span></span>
    </button>
    <button class="btn" id="modeToggle" type="button" aria-label="Toggle mode">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm0 18a8 8 0 1 1 0-16Z" />
        <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
      <span id="modeToggleLabel">Mode</span>
    </button>
    <a class="btn btn-solid" href={profile.resume} download>Download CV</a>
  </div>

  <div class="menu-panel" id="menuPanel">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
</nav>

<script is:inline>
  (function () {
    var toggle = document.getElementById('modeToggle');
    var label = document.getElementById('modeToggleLabel');
    if (!toggle || !label) return;
    function sync() {
      var mode = document.documentElement.getAttribute('data-mode');
      label.textContent = mode === 'experience' ? 'Simple mode' : 'Experience mode';
    }
    sync();
    toggle.addEventListener('click', function () {
      var mode = document.documentElement.getAttribute('data-mode');
      try {
        localStorage.setItem('daleth-mode', mode === 'experience' ? 'simple' : 'experience');
      } catch (e) {}
      window.location.reload();
    });
  })();

  (function () {
    var burger = document.getElementById('menuBurger');
    var panel = document.getElementById('menuPanel');
    if (!burger || !panel) return;
    function close() {
      burger.setAttribute('aria-expanded', 'false');
      panel.classList.remove('open');
    }
    burger.addEventListener('click', function () {
      var open = panel.classList.toggle('open');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    panel.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', close);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  })();
</script>
