---
import { journey } from '../data/profile.js';
const INK = '#0A0A0A';
const PAPER = '#FFFFFF';
---
<section class="journey" id="trayectoria">
  {journey.map((scene) => (
    <article class="journey-scene">
      <div class="scene-card">
        <span class="scene-step">Chapter {scene.step}</span>
        <div class="scene-illu">
          {scene.id === 'robots' && (
            <svg viewBox="0 0 220 150" role="img" aria-label="Robot illustration" width="220" height="150">
              <rect x="40" y="30" width="140" height="95" rx="22" fill={PAPER} stroke={INK} stroke-width="3" />
              <rect x="64" y="50" width="30" height="30" rx="6" fill={PAPER} stroke={INK} stroke-width="3" />
              <rect x="126" y="50" width="30" height="30" rx="6" fill={PAPER} stroke={INK} stroke-width="3" />
              <circle cx="79" cy="65" r="5" fill={INK} />
              <circle cx="141" cy="65" r="5" fill={INK} />
              <path d="M95 88h30" stroke={INK} stroke-width="3" stroke-linecap="round" />
              <rect x="102" y="18" width="16" height="16" rx="4" fill={INK} />
              <circle cx="110" cy="10" r="5" fill={INK} />
              <rect x="60" y="125" width="22" height="15" rx="5" fill={INK} />
              <rect x="138" y="125" width="22" height="15" rx="5" fill={INK} />
              <rect x="102" y="120" width="16" height="12" rx="3" fill={PAPER} stroke={INK} stroke-width="3" />
            </svg>
          )}
          {scene.id === 'circuits' && (
            <svg viewBox="0 0 220 150" role="img" aria-label="Circuit board illustration" width="220" height="150">
              <rect x="20" y="15" width="180" height="120" rx="14" fill={PAPER} stroke={INK} stroke-width="3" />
              <rect x="30" y="25" width="30" height="26" rx="4" fill={PAPER} stroke={INK} stroke-width="2.5" />
              <path d="M45 51v22" stroke={INK} stroke-width="2.5" stroke-linecap="round" />
              <rect x="36" y="73" width="18" height="10" rx="2" fill={INK} />
              <rect x="150" y="24" width="36" height="36" rx="4" fill={INK} />
              <rect x="157" y="31" width="22" height="22" rx="3" fill={PAPER} />
              <path d="M70 45h34v30H70z" fill="none" stroke={INK} stroke-width="2.5" stroke-linecap="round" />
              <path d="M104 60h22v26h24" fill="none" stroke={INK} stroke-width="2.5" stroke-linecap="round" />
              <path d="M84 45V30h40" fill="none" stroke={INK} stroke-width="2.5" stroke-linecap="round" />
              <circle cx="84" cy="45" r="5" fill={INK} />
              <circle cx="150" cy="86" r="5" fill={INK} />
              <path d="M64 100h30" stroke={INK} stroke-width="2.5" stroke-linecap="round" />
              <circle cx="64" cy="100" r="5" fill={PAPER} stroke={INK} stroke-width="2" />
            </svg>
          )}
          {scene.id === 'quantum' && (
            <svg viewBox="0 0 220 150" role="img" aria-label="Quantum atom illustration" width="220" height="150">
              <ellipse cx="110" cy="62" rx="92" ry="28" fill="none" stroke={INK} stroke-width="2.5" />
              <ellipse cx="110" cy="62" rx="92" ry="28" fill="none" stroke={INK} stroke-width="2.5" transform="rotate(60 110 62)" />
              <ellipse cx="110" cy="62" rx="92" ry="28" fill="none" stroke={INK} stroke-width="2.5" transform="rotate(-60 110 62)" />
              <circle cx="110" cy="62" r="14" fill={INK} />
              <circle cx="110" cy="62" r="5" fill={PAPER} />
              <circle cx="196" cy="70" r="8" fill={PAPER} stroke={INK} stroke-width="3" />
              <circle cx="112" cy="36" r="8" fill={PAPER} stroke={INK} stroke-width="3" />
              <circle cx="28" cy="50" r="8" fill={PAPER} stroke={INK} stroke-width="3" />
            </svg>
          )}
          {scene.id === 'fpga' && (
            <div class="terminal">
              <div class="terminal-bar"><i></i><i></i><i></i></div>
              <div class="terminal-body"><span class="prompt">daleth@itech:~$</span> ./journey --since 2016
<span style="color:#8a8a86">found 4 chapters · loading timeline…</span>
<span class="prompt">daleth@itech:~$</span> amaranth build rtl --to fpga
<span style="color:#e8e8e4">✓</span> bitstream flashed · 12 ns
<span class="prompt">daleth@itech:~$</span> <span class="cursor" aria-hidden="true"></span>
</div>
            </div>
          )}
          {scene.id === 'chips' && (
            <svg viewBox="0 0 220 150" role="img" aria-label="Microprocessor illustration" width="220" height="150">
              <rect x="66" y="36" width="88" height="88" rx="8" fill={INK} />
              <rect x="76" y="46" width="68" height="68" rx="4" fill={PAPER} stroke={INK} stroke-width="2.5" />
              <path d="M80 55h60M80 66h60M80 77h60M80 88h60M80 99h60" stroke={INK} stroke-width="2.5" />
              <path d="M89 50v60M100 50v60M111 50v60M122 50v60M133 50v60" stroke={INK} stroke-width="2.5" />
              <g fill={PAPER} stroke={INK} stroke-width="1.5">
                <rect x="80" y="24" width="12" height="12" rx="2" />
                <rect x="100" y="24" width="12" height="12" rx="2" />
                <rect x="120" y="24" width="12" height="12" rx="2" />
                <rect x="80" y="124" width="12" height="12" rx="2" />
                <rect x="100" y="124" width="12" height="12" rx="2" />
                <rect x="120" y="124" width="12" height="12" rx="2" />
                <rect x="54" y="56" width="12" height="12" rx="2" />
                <rect x="54" y="82" width="12" height="12" rx="2" />
                <rect x="54" y="108" width="12" height="12" rx="2" />
                <rect x="154" y="56" width="12" height="12" rx="2" />
                <rect x="154" y="82" width="12" height="12" rx="2" />
                <rect x="154" y="108" width="12" height="12" rx="2" />
              </g>
            </svg>
          )}
          {scene.id === 'mind' && (
            <svg viewBox="0 0 220 150" role="img" aria-label="Brain illustration" width="220" height="150">
              <path
                d="M110 34c-20 0-34 12-34 30 0 9 4 17 10 22-2 4-3 9 0 13 3 5 9 6 13 4 1 7 6 12 11 12s10-5 11-12c4 2 10 1 13-4 3-4 2-9 0-13 6-5 10-13 10-22 0-18-14-30-34-30Z"
                fill={PAPER}
                stroke={INK}
                stroke-width="3"
                stroke-linejoin="round"
              />
              <path d="M86 58h48M86 70h38M90 82h36M100 94h20" stroke={INK} stroke-width="4" stroke-linecap="round" />
              <path d="M186 30l6 14 14 6-14 6-6 14-6-14-14-6 14-6z" fill={INK} />
              <path d="M150 100l4 9 9 4-9 4-4 9-4-9-9-4 9-4z" fill={INK} />
              <path d="M30 40l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" fill={INK} />
            </svg>
          )}
        </div>
        <h3>{scene.title}</h3>
        <span class="scene-period">{scene.period}</span>
        <p>{scene.text}</p>
        <span class="scene-badge">{scene.badge}</span>
      </div>
    </article>
  ))}

  <div class="journey-progress" aria-hidden="true">
    {journey.map(() => <i></i>)}
  </div>
</section>
